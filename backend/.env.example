# Database configuration
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/the_clock_is_running

# Security & Authentication
SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Base64-encoded 32-byte key for Fernet MFA secret encryption (optional, derived if empty)
MFA_ENCRYPTION_KEY=

# Application Settings
PROJECT_NAME="THE CLOCK IS RUNNING"
ENVIRONMENT=development

# Preserved AI configuration (reserved for future developer integration)
GEMINI_API_KEY=replace_me

# Gmail SMTP Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=

# Email OTP MFA Configuration
OTP_EXPIRY_MINUTES=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_MAX_ATTEMPTS=5
